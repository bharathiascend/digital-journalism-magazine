---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdPlacement from '../../components/AdPlacement.astro';
import { SECTIONS, getPublishableStories, getFormatMeta, type SectionMeta, type StoryEntry } from '../../utils/stories';

export async function getStaticPaths() {
  const allStories = await getPublishableStories();

  // Strict editorial mapping: each subject section contains EXACTLY the 3 authentic reporting submissions
  const sectionSlugs: Record<string, string[]> = {
    national: [
      'fast-for-justice-hunger-strikes',
      'el-nino-india-climate-vulnerability',
      'old-guard-new-noise',
    ],
    politics: [
      'why-tamil-nadu-refuses-to-yield-on-neet',
      'what-new-yorkers-think-zohran-mamdani',
      'arasiyal-oru-sakkadai-genz-dmk',
    ],
    lifestyle: [
      'striking-the-balance-pa-ranjith',
      'dalit-vegan-food-culture',
      'male-loneliness-epidemic',
    ],
    sports: [
      'how-chennais-chess-culture-is-growing',
      'hungarian-grand-prix-race-report',
      'tamil-nadu-sports-budget-jump',
    ],
    analysis: [
      'from-tn-fact-checking-unit-to-integrity-desk',
      'one-neet-protest-two-media-narratives',
      'when-the-cell-becomes-the-story',
    ],
  };

  return SECTIONS.map((section) => {
    const slugs = sectionSlugs[section.id] || [];
    const sectionStories = slugs
      .map((slug) => allStories.find((s) => s.data.slug === slug))
      .filter((s): s is StoryEntry => Boolean(s));

    return {
      params: { section: section.id },
      props: {
        section,
        stories: sectionStories,
      },
    };
  });
}

interface Props {
  section: SectionMeta;
  stories: StoryEntry[];
}

const { section, stories } = Astro.props;

// Contextual partner creative per section
const sectionAdMap: Record<string, { label: string; advertiser: string; src: string; tagline: string }> = {
  national: {
    label: 'Promotional Feature',
    advertiser: 'Vetri CA Academy',
    src: '/media/ads/ad-vetri-ca.jpg',
    tagline: 'Premier Professional Coaching for CA Foundation & Intermediate Aspirants',
  },
  politics: {
    label: 'Media Partner',
    advertiser: 'Rhythm Media Solutions',
    src: '/media/ads/ad-rhythm-media.jpg',
    tagline: 'Digital Strategy, Creative Content, and Multi-Platform Distribution',
  },
  lifestyle: {
    label: 'Sponsor Spotlight',
    advertiser: 'Borcelle Cafe',
    src: '/media/ads/ad-borcelle-cafe.png',
    tagline: 'Artisanal Plant-Based Brews & Wholesome Vegan Dining',
  },
  sports: {
    label: 'Media Partner',
    advertiser: 'Rhythm Media Solutions',
    src: '/media/ads/ad-rhythm-media.jpg',
    tagline: 'Sports Media Production & Athletics Broadcast Strategy',
  },
  analysis: {
    label: 'Promotional Feature',
    advertiser: 'Vetri CA Academy',
    src: '/media/ads/ad-vetri-ca.jpg',
    tagline: 'Rigorous Academic Guidance for Aspiring Financial Journalists & Analysts',
  },
};

const sectionAd = sectionAdMap[section.id];
---

<BaseLayout
  title={`${section.label} Archive`}
  description={section.description}
>
  <div class="shell archive-page">
    <header class="archive-header reading-width">
      <nav class="breadcrumb-nav" aria-label="Section breadcrumbs">
        <a class="text-link breadcrumb" href="/">← Home</a>
        <span class="breadcrumb-separator" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Sections</span>
      </nav>
      <p class="eyebrow archive-kicker">Subject Desk <span aria-hidden="true">/</span> GLASNOST</p>
      <h1 class="archive-title">{section.label}</h1>
      <p class="archive-deck">{section.description}</p>
    </header>

    <main class="archive-content">
      {stories.length > 0 ? (
        <section aria-labelledby="section-stories-title">
          <h2 id="section-stories-title" class="sr-only">Stories published in {section.label}</h2>
          <div class="three-column-grid">
          {stories.map((story) => {
            const format = getFormatMeta(story.data.format);
            return (
              <ArticleCard
                title={story.data.title}
                category={section.shortLabel}
                format={format?.badgeLabel ?? story.data.format}
                description={story.data.excerpt ?? story.data.subtitle}
                href={`/stories/${story.data.slug}/`}
                author={story.data.authors?.[0]?.name}
                publishedAt={story.data.publishedAt}
                dateLabel={story.data.dateLabel}
                variant={story.data.heroImage?.variant ?? 'paper'}
                imageSrc={story.data.heroImage?.src}
                imageAlt={story.data.heroImage?.alt || story.data.title}
              />
            );
          })}
          </div>
        </section>
      ) : (
        <div class="empty-archive-state reading-width">
          <div class="empty-state-card">
            <span class="status-dot" aria-hidden="true"></span>
            <h2 class="empty-state-heading">No stories currently listed in {section.label}</h2>
            <div class="empty-state-actions">
              <a class="text-link" href="/">← Return to GLASNOST homepage</a>
            </div>
          </div>
        </div>
      )}

      {sectionAd && (
        <AdPlacement
          label={sectionAd.label}
          advertiserName={sectionAd.advertiser}
          imageSrc={sectionAd.src}
          imageAlt={sectionAd.advertiser}
          tagline={sectionAd.tagline}
        />
      )}
    </main>
  </div>
</BaseLayout>
