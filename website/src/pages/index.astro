---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AdPlacement from '../components/AdPlacement.astro';
import PlaceholderArt from '../components/PlaceholderArt.astro';
import LatestStoriesSidebar from '../components/LatestStoriesSidebar.astro';
import { getPublishableStories, getSectionMeta, getFormatMeta, type StoryEntry } from '../utils/stories';
import appearance from '../data/appearance.json';

const stories = await getPublishableStories();
const hasStories = stories.length > 0;

// Chronologically sorted approved stories (newest first)
const sortedStories = [...stories]
  .filter((s) => s.data.status === 'approved' && !s.data.isDemo)
  .sort((a, b) => {
    const dateA = a.data.publishedAt ? new Date(a.data.publishedAt).getTime() : 0;
    const dateB = b.data.publishedAt ? new Date(b.data.publishedAt).getTime() : 0;
    return dateB - dateA;
  });

// Lead story: flagship investigative piece
const featuredStory = stories.find((s) => s.data.slug === 'why-tamil-nadu-refuses-to-yield-on-neet') ?? sortedStories[0];

// The Reading Desk: top dispatches from contributors dynamically selected (excluding lead story)
const latestStories = sortedStories
  .filter((s) => s.data.slug !== featuredStory?.data.slug)
  .slice(0, 3);

// News Analysis investigations (all 3)
const analysisStories = [
  stories.find((s) => s.data.slug === 'from-tn-fact-checking-unit-to-integrity-desk'),
  stories.find((s) => s.data.slug === 'one-neet-protest-two-media-narratives'),
  stories.find((s) => s.data.slug === 'when-the-cell-becomes-the-story'),
].filter((s): s is StoryEntry => Boolean(s));

// Student Blog submissions (all 3 authentic blogs)
const blogStories = [
  stories.find((s) => s.data.slug === 'never-ending-reincarnations-artist'),
  stories.find((s) => s.data.slug === 'finding-marakkave-ninaikiren'),
  stories.find((s) => s.data.slug === 'is-it-a-privilege'),
].filter((s): s is StoryEntry => Boolean(s));

// Subject desks
const nationalStory = stories.find((s) => s.data.slug === 'el-nino-india-climate-vulnerability');
const politicsStory = stories.find((s) => s.data.slug === 'what-new-yorkers-think-zohran-mamdani');
const lifestyleStory = stories.find((s) => s.data.slug === 'striking-the-balance-pa-ranjith');
const sportsStory = stories.find((s) => s.data.slug === 'how-chennais-chess-culture-is-growing');

// Multimedia reporting
const videoStories = stories.filter((s) => s.data.format === 'video');
const podcastStories = stories.filter((s) => s.data.format === 'podcast');

// Visual Journalism & Polls
const photoFeatureStory = stories.find((s) => s.data.slug === 'anti-neet-student-mobilisation-chennai') ?? stories.find((s) => s.data.format === 'photo-feature');
const pollStories = [
  stories.find((s) => s.data.slug === 'class-12-career-choice-tug-of-war'),
  stories.find((s) => s.data.slug === 'dorothy-audience-opinion-report'),
  stories.find((s) => s.data.slug === 'exit-polls-young-urban-indians'),
].filter((s): s is StoryEntry => Boolean(s));

function storyAudioPoster(story: StoryEntry): string | undefined {
  return story.data.heroImage?.src;
}
---

<BaseLayout title="Independent Student Digital Magazine">
  <div class="shell">
    {hasStories ? (
      <>
        {/* Edition Ribbon */}
        {appearance.showEditionRibbon && (
          <div class="edition-ribbon" aria-label="Edition details">
            <span class="edition-ribbon-left">{appearance.editionVolume}</span>
            <div class="edition-ribbon-right">
              <span>{appearance.metaBannerRight}</span>
            </div>
          </div>
        )}

        {/* 1. Featured Lead Story */}
        {featuredStory && (
          <section class:list={['lead-section', `lead-${appearance.heroLayout}`]} aria-labelledby="featured-title">
            <div class="lead-copy">
              <p class="eyebrow">
                <span>Lead Investigation</span>
                <span aria-hidden="true">/</span>
                <span>{getSectionMeta(featuredStory.data.section)?.label ?? featuredStory.data.section}</span>
              </p>
              <h1 id="featured-title">
                <a href={`/stories/${featuredStory.data.slug}/`}>{featuredStory.data.title}</a>
              </h1>
              {featuredStory.data.subtitle && <p class="lead-deck">{featuredStory.data.subtitle}</p>}
              <p class="card-meta">
                By <strong>{featuredStory.data.authors?.[0]?.name ?? 'Editorial Desk'}</strong>
                {featuredStory.data.dateLabel && (
                  <>
                    <span aria-hidden="true">·</span>
                    <time datetime={featuredStory.data.publishedAt}>{featuredStory.data.dateLabel}</time>
                  </>
                )}
              </p>
              <a class="text-link lead-link" href={`/stories/${featuredStory.data.slug}/`}>
                Read the investigation <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="lead-figure">
              {featuredStory.data.heroImage?.src ? (
                <img
                  src={featuredStory.data.heroImage.src}
                  alt={featuredStory.data.heroImage.alt || featuredStory.data.title}
                  class="lead-hero-img"
                  loading="eager"
                />
              ) : (
                <PlaceholderArt
                  variant={featuredStory.data.heroImage?.variant ?? 'paper'}
                  label={featuredStory.data.title}
                />
              )}
              <figcaption>
                {featuredStory.data.heroImage?.caption ?? 'An editorial composition.'}
                {featuredStory.data.heroImage?.credit && <span class="caption-credit"> — {featuredStory.data.heroImage.credit}</span>}
              </figcaption>
            </figure>
          </section>
        )}

        {/* 2. Latest Stories (Reading Desk) & Latest Dispatches Sidebar */}
        {latestStories.length > 0 && (
          <section class="section-block" id="latest" aria-labelledby="latest-title">
            <SectionHeading
              id="latest-title"
              title="The Reading Desk"
              eyebrow="Recent dispatches"
              href="/formats/article/"
              linkLabel="View all articles"
            />
            <div class="homepage-reading-grid">
              <div class="reading-desk-main">
                <div class:list={['two-column-grid', `layout-${appearance.readingDeskLayout}`]}>
                  {latestStories.map((story) => {
                    const section = getSectionMeta(story.data.section);
                    const format = getFormatMeta(story.data.format);
                    return (
                      <ArticleCard
                        title={story.data.title}
                        category={section?.shortLabel ?? story.data.section}
                        format={format?.badgeLabel ?? story.data.format}
                        description={story.data.excerpt ?? story.data.subtitle}
                        href={`/stories/${story.data.slug}/`}
                        author={story.data.authors?.[0]?.name}
                        publishedAt={story.data.publishedAt}
                        dateLabel={story.data.dateLabel}
                        imageSrc={story.data.heroImage?.src}
                        imageAlt={story.data.heroImage?.alt || story.data.title}
                        layout={appearance.readingDeskLayout === 'list' ? 'compact' : 'standard'}
                      />
                    );
                  })}
                </div>
              </div>

              <aside class="homepage-sidebar-col">
                <LatestStoriesSidebar
                  limit={6}
                  excludeSlug={featuredStory?.data.slug}
                  heading="Latest News"
                  eyebrow="Recent Dispatches"
                  viewAllHref="/formats/article/"
                  viewAllLabel="View all stories"
                />
              </aside>
            </div>
          </section>
        )}

        {/* 3. News Analysis & Institutional Scrutiny */}
        {analysisStories.length > 0 && (
          <section class="section-block analysis-section-block" id="analysis" aria-labelledby="analysis-title">
            <SectionHeading
              id="analysis-title"
              title="News Analysis & Inquiries"
              eyebrow="Special editorial investigations"
              href="/sections/analysis/"
              linkLabel="Explore analysis desk"
            />
            <p class="section-intro">Forensic media framing analyses, government accountability deep dives, and systemic institutional critiques.</p>
            <div class="three-column-grid">
              {analysisStories.map((story) => (
                <ArticleCard
                  title={story.data.title}
                  category="News Analysis"
                  format="Investigation"
                  description={story.data.excerpt ?? story.data.subtitle}
                  href={`/stories/${story.data.slug}/`}
                  author={story.data.authors?.[0]?.name}
                  publishedAt={story.data.publishedAt}
                  dateLabel={story.data.dateLabel}
                  imageSrc={story.data.heroImage?.src}
                  imageAlt={story.data.heroImage?.alt || story.data.title}
                />
              ))}
            </div>
          </section>
        )}

        {/* 4. Promotional Placement 1: Borcelle Cafe (Sponsor Spotlight) */}
        {appearance.showAdPlacements && (
          <AdPlacement
            label="Sponsor Spotlight"
            imageSrc="/media/ads/ad-borcelle-cafe.png"
            imageAlt="Borcelle Plant-based Cafe Promotional Creative"
            advertiserName="Borcelle Cafe"
            tagline="Artisanal Plant-Based Brews & Wholesome Vegan Dining · Student Haven"
          />
        )}

        {/* 5. Student Essays & Blog Desk */}
        {blogStories.length > 0 && (
          <section class="section-block blog-desk-block" id="blogs" aria-labelledby="blog-title">
            <SectionHeading
              id="blog-title"
              title="Essays & Dispatches"
              eyebrow="Student Blog Desk"
              href="/formats/blog/"
              linkLabel="View all blogs & essays"
            />
            <p class="section-intro">Reflective cultural commentary, literary essays, and personal meditations from student journalists.</p>
            <div class="three-column-grid">
              {blogStories.map((story) => (
                <ArticleCard
                  title={story.data.title}
                  category="Culture"
                  format="Student Blog"
                  description={story.data.excerpt ?? story.data.subtitle}
                  href={`/stories/${story.data.slug}/`}
                  author={story.data.authors?.[0]?.name}
                  publishedAt={story.data.publishedAt}
                  dateLabel={story.data.dateLabel}
                  imageSrc={story.data.heroImage?.src}
                  imageAlt={story.data.heroImage?.alt || story.data.title}
                />
              ))}
            </div>
          </section>
        )}

        {/* 6. Public Life: National & Politics */}
        {(nationalStory || politicsStory) && (
          <section class="section-block" aria-labelledby="public-life-title">
            <SectionHeading id="public-life-title" title="National & Politics" eyebrow="Power, policy & environment" />
            <div class="two-column-grid topic-grid">
              {nationalStory && (
                <div id="national" class="topic-column">
                  <a href="/sections/national/" class="topic-link">
                    <h3 class="topic-label">National Reporting <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={nationalStory.data.title}
                    category="National"
                    format="Article"
                    description={nationalStory.data.excerpt ?? nationalStory.data.subtitle}
                    href={`/stories/${nationalStory.data.slug}/`}
                    author={nationalStory.data.authors?.[0]?.name}
                    publishedAt={nationalStory.data.publishedAt}
                    dateLabel={nationalStory.data.dateLabel}
                    imageSrc={nationalStory.data.heroImage?.src}
                    imageAlt={nationalStory.data.heroImage?.alt || nationalStory.data.title}
                    layout="compact"
                  />
                </div>
              )}
              {politicsStory && (
                <div id="politics" class="topic-column">
                  <a href="/sections/politics/" class="topic-link">
                    <h3 class="topic-label">Politics Desk <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={politicsStory.data.title}
                    category="Politics"
                    format="Article"
                    description={politicsStory.data.excerpt ?? politicsStory.data.subtitle}
                    href={`/stories/${politicsStory.data.slug}/`}
                    author={politicsStory.data.authors?.[0]?.name}
                    publishedAt={politicsStory.data.publishedAt}
                    dateLabel={politicsStory.data.dateLabel}
                    imageSrc={politicsStory.data.heroImage?.src}
                    imageAlt={politicsStory.data.heroImage?.alt || politicsStory.data.title}
                    layout="compact"
                  />
                </div>
              )}
            </div>
          </section>
        )}

        {/* 7. Promotional Placement 2: Rhythm Media Solutions (Media Partner) */}
        {appearance.showAdPlacements && (
          <AdPlacement
            label="Media Partner"
            imageSrc="/media/ads/ad-rhythm-media.jpg"
            imageAlt="Rhythm Media Solutions - Strategy, Creative, and Distribution"
            advertiserName="Rhythm Media Solutions"
            tagline="Digital Strategy, Creative Content, and Multi-Platform Distribution"
          />
        )}

        {/* 8. Culture & Movement: Lifestyle & Sports */}
        {(lifestyleStory || sportsStory) && (
          <section class="section-block" aria-labelledby="life-title">
            <SectionHeading id="life-title" title="Lifestyle & Sports" eyebrow="Culture, cinema & athletics" />
            <div class="two-column-grid topic-grid">
              {lifestyleStory && (
                <div id="lifestyle" class="topic-column">
                  <a href="/sections/lifestyle/" class="topic-link">
                    <h3 class="topic-label">Lifestyle &amp; Cinema <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={lifestyleStory.data.title}
                    category="Lifestyle"
                    format="Article"
                    description={lifestyleStory.data.excerpt ?? lifestyleStory.data.subtitle}
                    href={`/stories/${lifestyleStory.data.slug}/`}
                    author={lifestyleStory.data.authors?.[0]?.name}
                    publishedAt={lifestyleStory.data.publishedAt}
                    dateLabel={lifestyleStory.data.dateLabel}
                    imageSrc={lifestyleStory.data.heroImage?.src}
                    imageAlt={lifestyleStory.data.heroImage?.alt || lifestyleStory.data.title}
                    layout="compact"
                  />
                </div>
              )}
              {sportsStory && (
                <div id="sports" class="topic-column">
                  <a href="/sections/sports/" class="topic-link">
                    <h3 class="topic-label">Sports Desk <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={sportsStory.data.title}
                    category="Sports"
                    format="Article"
                    description={sportsStory.data.excerpt ?? sportsStory.data.subtitle}
                    href={`/stories/${sportsStory.data.slug}/`}
                    author={sportsStory.data.authors?.[0]?.name}
                    publishedAt={sportsStory.data.publishedAt}
                    dateLabel={sportsStory.data.dateLabel}
                    imageSrc={sportsStory.data.heroImage?.src}
                    imageAlt={sportsStory.data.heroImage?.alt || sportsStory.data.title}
                    layout="compact"
                  />
                </div>
              )}
            </div>
          </section>
        )}

        {/* 9. Visual Journalism: Photo Features */}
        {photoFeatureStory && (
          <section class="section-block photo-section" id="photo-features" aria-labelledby="photo-title">
            <SectionHeading
              id="photo-title"
              title="Visual Journalism"
              eyebrow="On the ground"
              href="/formats/photo-feature/"
              linkLabel="View photo features"
            />
            <div class="photo-feature">
              {photoFeatureStory.data.heroImage?.src ? (
                <img
                  src={photoFeatureStory.data.heroImage.src}
                  alt={photoFeatureStory.data.heroImage.alt || photoFeatureStory.data.title}
                  class="photo-feature-lead-img"
                  loading="lazy"
                />
              ) : (
                <PlaceholderArt
                  variant="frames"
                  label={photoFeatureStory.data.title}
                />
              )}
              <div class="photo-copy">
                <p class="eyebrow">Photo Feature <span aria-hidden="true">/</span> Ground Report</p>
                <h3>
                  <a href={`/stories/${photoFeatureStory.data.slug}/`}>{photoFeatureStory.data.title}</a>
                </h3>
                <p>{photoFeatureStory.data.excerpt ?? photoFeatureStory.data.subtitle}</p>
                <p class="card-meta">
                  By <strong>{photoFeatureStory.data.authors?.[0]?.name ?? 'Visual Desk'}</strong>
                  <span aria-hidden="true">·</span>
                  <span>{photoFeatureStory.data.dateLabel}</span>
                </p>
                <a class="text-link" href={`/stories/${photoFeatureStory.data.slug}/`}>
                  Explore the full photo feature <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </section>
        )}

        {/* 10. Campus Culture & Events Banner Showcase (All 3 Banners) */}
        {appearance.showCampusBanners && (
          <section class="section-block banner-showcase-section" id="banners" aria-labelledby="banners-heading">
            <SectionHeading
              id="banners-heading"
              title="Campus Culture & Events"
              eyebrow="Promotional Creative Showcase"
            />
            <p class="section-intro">Student-designed promotional banners for campus gatherings, nightlife events, and festive seasonal showcases.</p>
            <div class="banner-showcase-grid">
              <div class="banner-item">
                <div class="banner-frame">
                  <img
                    src="/media/banners/banner-fomo-klub.png"
                    alt="FOMO Klub Student Night Event Creative"
                    class="banner-artwork-img"
                    loading="eager"
                  />
                </div>
                <div class="banner-meta">
                  <span class="banner-contributor">By Aradhana</span>
                  <span class="banner-desc">FOMO Klub · Campus Gathering &amp; Student Nightlife Creative</span>
                </div>
              </div>

              <div class="banner-item">
                <div class="banner-frame">
                  <img
                    src="/media/banners/banner-serene-halloween.jpg"
                    alt="Serene Halloween Student Festival Creative"
                    class="banner-artwork-img"
                    loading="eager"
                  />
                </div>
                <div class="banner-meta">
                  <span class="banner-contributor">By Dhanushree</span>
                  <span class="banner-desc">Serene Halloween · Autumn Campus Festival &amp; Costume Gathering</span>
                </div>
              </div>

              <div class="banner-item">
                <div class="banner-frame">
                  <img
                    src="/media/banners/banner-women-apparels.jpg"
                    alt="Women Apparels Festive Showcase Banner"
                    class="banner-artwork-img"
                    loading="eager"
                  />
                </div>
                <div class="banner-meta">
                  <span class="banner-contributor">By Mithraa</span>
                  <span class="banner-desc">Women Apparels · Festive Campaign &amp; Student Fashion Showcase</span>
                </div>
              </div>
            </div>
          </section>
        )}

        {/* 11. Watch & Listen: Video & Podcasts */}
        {(videoStories.length > 0 || podcastStories.length > 0) && (
          <section class="section-block" id="watch-listen" aria-labelledby="media-title">
            <SectionHeading
              id="media-title"
              title="Watch & Listen"
              eyebrow="Multimedia broadcasting"
              href="/formats/video/"
              linkLabel="Explore multimedia"
            />
            <p class="section-intro">Mobile-first vertical journalism and student audio dispatches on culture, sports, and economy.</p>
            <div class="two-column-grid">
              {videoStories[0] && (
                <ArticleCard
                  title={videoStories[0].data.title}
                  category="Watch"
                  format="Video Explainer"
                  description={videoStories[0].data.excerpt ?? videoStories[0].data.subtitle}
                  href={`/stories/${videoStories[0].data.slug}/`}
                  author={videoStories[0].data.authors?.[0]?.name}
                  publishedAt={videoStories[0].data.publishedAt}
                  dateLabel={videoStories[0].data.dateLabel}
                  imageSrc={videoStories[0].data.heroImage?.src}
                  imageAlt={videoStories[0].data.heroImage?.alt || videoStories[0].data.title}
                />
              )}
              {podcastStories[0] && (
                <ArticleCard
                  title={podcastStories[0].data.title}
                  category="Listen"
                  format="Glasnost Podcast"
                  description={podcastStories[0].data.excerpt ?? podcastStories[0].data.subtitle}
                  href={`/stories/${podcastStories[0].data.slug}/`}
                  author={podcastStories[0].data.authors?.[0]?.name}
                  publishedAt={podcastStories[0].data.publishedAt}
                  dateLabel={podcastStories[0].data.dateLabel}
                  imageSrc={storyAudioPoster(podcastStories[0])}
                  imageAlt={podcastStories[0].data.heroImage?.alt || podcastStories[0].data.title}
                />
              )}
            </div>
          </section>
        )}

        {/* 12. Public Sentiment: Opinion Polls */}
        {pollStories.length > 0 && (
          <section class="section-block" id="opinion-polls" aria-labelledby="polls-title">
            <SectionHeading
              id="polls-title"
              title="Campus & Public Opinion"
              eyebrow="Independent survey desk"
              href="/formats/poll-report/"
              linkLabel="View all poll reports"
            />
            <div class="three-column-grid">
              {pollStories.map((poll) => (
                <ArticleCard
                  title={poll.data.title}
                  category="Opinion Poll"
                  format="Survey Report"
                  description={poll.data.excerpt ?? poll.data.subtitle}
                  href={`/stories/${poll.data.slug}/`}
                  author={poll.data.authors?.[0]?.name}
                  publishedAt={poll.data.publishedAt}
                  dateLabel={poll.data.dateLabel}
                  imageSrc={poll.data.heroImage?.src}
                  imageAlt={poll.data.heroImage?.alt || poll.data.title}
                />
              ))}
            </div>
          </section>
        )}

        {/* 13. Promotional Placement 3: Vetri CA Academy (Promotional Feature) */}
        {appearance.showAdPlacements && (
          <AdPlacement
            label="Promotional Feature"
            imageSrc="/media/ads/ad-vetri-ca.jpg"
            imageAlt="Vetri CA Academy Educational Creative"
            advertiserName="Vetri CA Academy"
            tagline="Premier Coaching for CA Foundation, Intermediate & Final Examinations"
          />
        )}
      </>
    ) : (
      <div class="empty-archive-state reading-width">
        <p>No stories published.</p>
      </div>
    )}
  </div>
</BaseLayout>
