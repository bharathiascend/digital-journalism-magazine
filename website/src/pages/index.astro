---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AdPlacement from '../components/AdPlacement.astro';
import PlaceholderArt from '../components/PlaceholderArt.astro';
---
<BaseLayout title="Homepage design">
  <div class="shell">
    <section class="lead-section" aria-labelledby="featured-title">
      <div class="lead-copy">
        <p class="eyebrow">Featured story <span aria-hidden="true">/</span> Demo essay</p>
        <h1 id="featured-title"><a href="/sample-article/">Room to read.<br /><em>Space to think.</em></a></h1>
        <p class="lead-deck">A demonstration of thoughtful pacing, clear typography, and the pleasure of an unhurried page.</p>
        <p class="card-meta">Example Writer <span aria-hidden="true">·</span> Fictional placeholder</p>
        <a class="text-link lead-link" href="/sample-article/">Explore the sample article <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="lead-figure"><PlaceholderArt variant="paper" label="Featured image placeholder" /><figcaption>An original abstract composition. No source photograph is used.</figcaption></figure>
    </section>

    <section class="section-block" id="latest" aria-labelledby="latest-title">
      <SectionHeading id="latest-title" title="Latest stories" eyebrow="The reading desk" href="/sample-article/" />
      <div class="three-column-grid">
        <ArticleCard category="Essay" title="The art of looking a little closer" description="A fictional layout example for a short essay, with room for an introduction and a clear byline." variant="arches" />
        <ArticleCard category="Perspective" title="A pause between the lines" description="Neutral demonstration text showing how a quieter story sits alongside a lead feature." variant="orbit" />
        <ArticleCard category="Notebook" title="Small details, a wider frame" description="A sample card exploring the rhythm of a headline, an illustration, and a few introductory lines." variant="frames" />
      </div>
    </section>

    <section class="section-block" aria-labelledby="public-life-title">
      <SectionHeading id="public-life-title" title="National & politics" eyebrow="Perspectives in focus" />
      <div class="two-column-grid topic-grid">
        <div id="national" class="topic-column"><h3 class="topic-label">National</h3><ArticleCard category="National" format="Section demo" title="A place for the larger picture" description="This is a fictional section placeholder, demonstrating space for a future national story. It reports no event." variant="arches" layout="compact" /></div>
        <div id="politics" class="topic-column"><h3 class="topic-label">Politics</h3><ArticleCard category="Politics" format="Section demo" title="Questions with room to unfold" description="A neutral demonstration of the politics card layout. No people, policies, or real-world claims are represented." variant="paper" layout="compact" /></div>
      </div>
    </section>

    <section class="section-block" aria-labelledby="life-title">
      <SectionHeading id="life-title" title="Lifestyle & sports" eyebrow="Beyond the everyday" />
      <div class="two-column-grid topic-grid">
        <div id="lifestyle" class="topic-column"><h3 class="topic-label">Lifestyle</h3><ArticleCard category="Lifestyle" format="Section demo" title="Everyday rhythms, thoughtfully observed" description="Fictional placeholder text for the lifestyle section. The illustration is an original abstract design." variant="frames" layout="compact" /></div>
        <div id="sports" class="topic-column"><h3 class="topic-label">Sports</h3><ArticleCard category="Sports" format="Section demo" title="A different way to follow the movement" description="A sample sports card without invented matches, results, or athletes. Open it to review the shared article layout." variant="orbit" layout="compact" /></div>
      </div>
    </section>

    <AdPlacement />

    <section class="section-block" id="watch-listen" aria-labelledby="media-title">
      <SectionHeading id="media-title" title="Watch & listen" eyebrow="Another way into the story" />
      <p class="section-intro">Format demonstrations. No audio or video is loaded in this prototype.</p>
      <div class="two-column-grid">
        <ArticleCard category="Watch" format="Video layout demo" title="A story told one frame at a time" description="A placeholder for a future video explainer. This link opens the sample reading layout, not a media player." variant="arches" />
        <ArticleCard category="Listen" format="Podcast layout demo" title="Making room for a conversation" description="A placeholder for a future podcast. Audio, episode credits, and transcripts will be reviewed in a later stage." variant="sound" />
      </div>
    </section>

    <section class="section-block photo-section" id="photo-features" aria-labelledby="photo-title">
      <SectionHeading id="photo-title" title="Photo features" eyebrow="A visual notebook" />
      <div class="photo-feature">
        <PlaceholderArt variant="frames" label="Photo feature placeholder" />
        <div class="photo-copy"><p class="eyebrow">Visual essay <span aria-hidden="true">/</span> Demo</p><h3><a href="/sample-article/">The space<br />between frames</a></h3><p>A quiet canvas for images and their stories. This fictional layout uses abstract artwork to show scale and proportion.</p><p class="card-meta">Example Writer <span aria-hidden="true">·</span> Fictional placeholder</p><a class="text-link" href="/sample-article/">View the sample layout <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
  </div>
</BaseLayout>
