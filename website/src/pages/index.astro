---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AdPlacement from '../components/AdPlacement.astro';
import PlaceholderArt from '../components/PlaceholderArt.astro';
import { getPublishableStories, getSectionMeta, getFormatMeta, type StoryEntry } from '../utils/stories';

const stories = await getPublishableStories();
const hasStories = stories.length > 0;

// Lead story: first available article or first story
const featuredStory = stories.find((s) => s.data.format === 'article') ?? stories[0];
const otherStories = stories.filter((s) => s.id !== featuredStory?.id);

// Latest stories grid (up to 3 distinct stories)
const latestStories = otherStories.length >= 3 ? otherStories.slice(0, 3) : stories.slice(0, 3);

// Subject stories
const nationalStory = stories.find((s) => s.data.section === 'national');
const politicsStory = stories.find((s) => s.data.section === 'politics');
const lifestyleStory = stories.find((s) => s.data.section === 'lifestyle');
const sportsStory = stories.find((s) => s.data.section === 'sports');

// Multimedia stories
const videoStory = stories.find((s) => s.data.format === 'video');
const podcastStory = stories.find((s) => s.data.format === 'podcast');
const photoStory = stories.find((s) => s.data.format === 'photo-feature');
---

<BaseLayout title="Homepage">
  <div class="shell">
    {hasStories ? (
      <>
        {/* 1. Featured Lead Story */}
        {featuredStory && (
          <section class="lead-section" aria-labelledby="featured-title">
            <div class="lead-copy">
              <p class="eyebrow">
                <span>Featured story</span>
                <span aria-hidden="true">/</span>
                <span>{getSectionMeta(featuredStory.data.section)?.label ?? featuredStory.data.section}</span>
              </p>
              <h1 id="featured-title">
                <a href={`/stories/${featuredStory.data.slug}/`}>{featuredStory.data.title}</a>
              </h1>
              {featuredStory.data.subtitle && <p class="lead-deck">{featuredStory.data.subtitle}</p>}
              <p class="card-meta">
                {featuredStory.data.authors?.[0]?.name ?? 'Editorial Desk'}
                {featuredStory.data.dateLabel && (
                  <>
                    <span aria-hidden="true">·</span>
                    <time datetime={featuredStory.data.publishedAt}>{featuredStory.data.dateLabel}</time>
                  </>
                )}
                {featuredStory.data.isDemo && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>Demonstration record</span>
                  </>
                )}
              </p>
              <a class="text-link lead-link" href={`/stories/${featuredStory.data.slug}/`}>
                Read the story <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="lead-figure">
              {featuredStory.data.heroImage?.src ? (
                <img
                  src={featuredStory.data.heroImage.src}
                  alt={featuredStory.data.heroImage.alt || featuredStory.data.title}
                  class="lead-hero-img"
                  loading="eager"
                />
              ) : (
                <PlaceholderArt
                  variant={featuredStory.data.heroImage?.variant ?? 'paper'}
                  label={featuredStory.data.title}
                />
              )}
              <figcaption>
                {featuredStory.data.heroImage?.caption ?? 'An editorial composition.'}
              </figcaption>
            </figure>
          </section>
        )}

        {/* 2. Latest Stories */}
        {latestStories.length > 0 && (
          <section class="section-block" id="latest" aria-labelledby="latest-title">
            <SectionHeading
              id="latest-title"
              title="Latest stories"
              eyebrow="The reading desk"
              href="/formats/article/"
              linkLabel="View articles archive"
            />
            <div class="three-column-grid">
              {latestStories.map((story) => {
                const section = getSectionMeta(story.data.section);
                const format = getFormatMeta(story.data.format);
                return (
                  <ArticleCard
                    title={story.data.title}
                    category={section?.shortLabel ?? story.data.section}
                    format={format?.badgeLabel ?? story.data.format}
                    description={story.data.excerpt ?? story.data.subtitle}
                    href={`/stories/${story.data.slug}/`}
                    author={story.data.authors?.[0]?.name}
                    publishedAt={story.data.publishedAt}
                    dateLabel={story.data.dateLabel}
                    variant={story.data.heroImage?.variant ?? 'paper'}
                  />
                );
              })}
            </div>
          </section>
        )}

        {/* 3. National & Politics */}
        {(nationalStory || politicsStory) && (
          <section class="section-block" aria-labelledby="public-life-title">
            <SectionHeading id="public-life-title" title="National & politics" eyebrow="Perspectives in focus" />
            <div class="two-column-grid topic-grid">
              {nationalStory && (
                <div id="national" class="topic-column">
                  <a href="/sections/national/" class="topic-link">
                    <h3 class="topic-label">National <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={nationalStory.data.title}
                    category="National"
                    format={getFormatMeta(nationalStory.data.format)?.badgeLabel ?? nationalStory.data.format}
                    description={nationalStory.data.excerpt ?? nationalStory.data.subtitle}
                    href={`/stories/${nationalStory.data.slug}/`}
                    author={nationalStory.data.authors?.[0]?.name}
                    publishedAt={nationalStory.data.publishedAt}
                    dateLabel={nationalStory.data.dateLabel}
                    variant={nationalStory.data.heroImage?.variant ?? 'arches'}
                    layout="compact"
                  />
                </div>
              )}
              {politicsStory && (
                <div id="politics" class="topic-column">
                  <a href="/sections/politics/" class="topic-link">
                    <h3 class="topic-label">Politics <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={politicsStory.data.title}
                    category="Politics"
                    format={getFormatMeta(politicsStory.data.format)?.badgeLabel ?? politicsStory.data.format}
                    description={politicsStory.data.excerpt ?? politicsStory.data.subtitle}
                    href={`/stories/${politicsStory.data.slug}/`}
                    author={politicsStory.data.authors?.[0]?.name}
                    publishedAt={politicsStory.data.publishedAt}
                    dateLabel={politicsStory.data.dateLabel}
                    variant={politicsStory.data.heroImage?.variant ?? 'paper'}
                    layout="compact"
                  />
                </div>
              )}
            </div>
          </section>
        )}

        {/* 4. Lifestyle & Sports */}
        {(lifestyleStory || sportsStory) && (
          <section class="section-block" aria-labelledby="life-title">
            <SectionHeading id="life-title" title="Lifestyle & sports" eyebrow="Beyond the everyday" />
            <div class="two-column-grid topic-grid">
              {lifestyleStory && (
                <div id="lifestyle" class="topic-column">
                  <a href="/sections/lifestyle/" class="topic-link">
                    <h3 class="topic-label">Lifestyle <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={lifestyleStory.data.title}
                    category="Lifestyle"
                    format={getFormatMeta(lifestyleStory.data.format)?.badgeLabel ?? lifestyleStory.data.format}
                    description={lifestyleStory.data.excerpt ?? lifestyleStory.data.subtitle}
                    href={`/stories/${lifestyleStory.data.slug}/`}
                    author={lifestyleStory.data.authors?.[0]?.name}
                    publishedAt={lifestyleStory.data.publishedAt}
                    dateLabel={lifestyleStory.data.dateLabel}
                    variant={lifestyleStory.data.heroImage?.variant ?? 'frames'}
                    layout="compact"
                  />
                </div>
              )}
              {sportsStory && (
                <div id="sports" class="topic-column">
                  <a href="/sections/sports/" class="topic-link">
                    <h3 class="topic-label">Sports <span aria-hidden="true">→</span></h3>
                  </a>
                  <ArticleCard
                    title={sportsStory.data.title}
                    category="Sports"
                    format={getFormatMeta(sportsStory.data.format)?.badgeLabel ?? sportsStory.data.format}
                    description={sportsStory.data.excerpt ?? sportsStory.data.subtitle}
                    href={`/stories/${sportsStory.data.slug}/`}
                    author={sportsStory.data.authors?.[0]?.name}
                    publishedAt={sportsStory.data.publishedAt}
                    dateLabel={sportsStory.data.dateLabel}
                    variant={sportsStory.data.heroImage?.variant ?? 'orbit'}
                    layout="compact"
                  />
                </div>
              )}
            </div>
          </section>
        )}

        {/* 5. Promotional Placement */}
        <AdPlacement
          label="Advertisement"
          imageSrc="/media/ads/ad-borcelle-cafe.png"
          imageAlt="Borcelle Plant-based Cafe Promotional Creative"
          advertiserName="Borcelle Cafe"
        />

        {/* 6. Watch & Listen */}
        {(videoStory || podcastStory) && (
          <section class="section-block" id="watch-listen" aria-labelledby="media-title">
            <SectionHeading
              id="media-title"
              title="Watch & listen"
              eyebrow="Multimedia reporting"
              href="/formats/video/"
              linkLabel="View multimedia archive"
            />
            <p class="section-intro">Mobile-first journalism. Native 9:16 portrait video and independent podcasts.</p>
            <div class="two-column-grid">
              {videoStory && (
                <ArticleCard
                  title={videoStory.data.title}
                  category="Watch"
                  format="Video Explainer"
                  description={videoStory.data.excerpt ?? videoStory.data.subtitle}
                  href={`/stories/${videoStory.data.slug}/`}
                  author={videoStory.data.authors?.[0]?.name}
                  publishedAt={videoStory.data.publishedAt}
                  dateLabel={videoStory.data.dateLabel}
                  status={videoStory.data.status}
                  isDemo={videoStory.data.isDemo}
                  variant="arches"
                />
              )}
              {podcastStory && (
                <ArticleCard
                  title={podcastStory.data.title}
                  category="Listen"
                  format="Podcast"
                  description={podcastStory.data.excerpt ?? podcastStory.data.subtitle}
                  href={`/stories/${podcastStory.data.slug}/`}
                  author={podcastStory.data.authors?.[0]?.name}
                  publishedAt={podcastStory.data.publishedAt}
                  dateLabel={podcastStory.data.dateLabel}
                  status={podcastStory.data.status}
                  isDemo={podcastStory.data.isDemo}
                  variant="sound"
                />
              )}
            </div>
          </section>
        )}

        {/* 7. Photo Features */}
        {photoStory && (
          <section class="section-block photo-section" id="photo-features" aria-labelledby="photo-title">
            <SectionHeading
              id="photo-title"
              title="Photo features"
              eyebrow="A visual notebook"
              href="/formats/photo-feature/"
              linkLabel="View photo archive"
            />
            <div class="photo-feature">
              {photoStory.data.photoGallery?.[0]?.src ? (
                <img
                  src={photoStory.data.photoGallery[0].src}
                  alt={photoStory.data.photoGallery[0].alt || photoStory.data.title}
                  class="photo-feature-lead-img"
                  loading="lazy"
                />
              ) : (
                <PlaceholderArt
                  variant={photoStory.data.heroImage?.variant ?? 'frames'}
                  label={photoStory.data.title}
                />
              )}
              <div class="photo-copy">
                <p class="eyebrow">Visual essay <span aria-hidden="true">/</span> Feature</p>
                <h3>
                  <a href={`/stories/${photoStory.data.slug}/`}>{photoStory.data.title}</a>
                </h3>
                <p>{photoStory.data.excerpt ?? photoStory.data.subtitle}</p>
                <p class="card-meta">
                  {photoStory.data.authors?.[0]?.name ?? 'Visual Desk'}
                  {photoStory.data.status === 'needs-review' && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="card-review-tag">Review</span>
                    </>
                  )}
                  {photoStory.data.isDemo && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>Demo</span>
                    </>
                  )}
                </p>
                <a class="text-link" href={`/stories/${photoStory.data.slug}/`}>
                  View the photo feature <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        {/* Production Empty State: Displayed when no approved stories are released */}
        <section class="lead-section empty-homepage-lead" aria-labelledby="featured-title">
          <div class="lead-copy">
            <p class="eyebrow">The Reading Desk <span aria-hidden="true">/</span> Publication Notice</p>
            <h1 id="featured-title">Room to read.<br /><em>Space to think.</em></h1>
            <p class="lead-deck">
              THE JOURNAL is preparing its inaugural digital edition. Student reporting, investigative essays, opinion survey reports, and multimedia explainers are currently undergoing editorial review.
            </p>
            <p class="card-meta">Editorial Desk <span aria-hidden="true">·</span> Launch Edition in Preparation</p>
          </div>
          <figure class="lead-figure">
            <PlaceholderArt variant="paper" label="Publication edition cover" />
            <figcaption>Design foundation for THE JOURNAL. Source documents and reporting in editorial preparation.</figcaption>
          </figure>
        </section>

        <section class="section-block" aria-labelledby="desks-title">
          <SectionHeading id="desks-title" title="Reporting desks" eyebrow="Coverage areas" />
          <div class="empty-archive-state reading-width">
            <div class="empty-state-card">
              <span class="status-dot" aria-hidden="true"></span>
              <h2>Inaugural Stories in Editorial Preparation</h2>
              <p>
                No stories are publicly released in this production build. Reporting submissions across National, Politics, Lifestyle & Entertainment, and Sports are currently being verified against source records.
              </p>
              <div class="empty-state-actions">
                <p class="card-meta">Explore the editorial coverage desks:</p>
                <div class="desk-links">
                  <a class="text-link" href="/sections/national/">National Desk →</a>
                  <a class="text-link" href="/sections/politics/">Politics Desk →</a>
                  <a class="text-link" href="/sections/lifestyle/">Lifestyle & Culture →</a>
                  <a class="text-link" href="/sections/sports/">Sports Desk →</a>
                </div>
              </div>
            </div>
          </div>
        </section>

        <AdPlacement />

        <section class="section-block" aria-labelledby="multimedia-desks-title">
          <SectionHeading id="multimedia-desks-title" title="Multimedia formats" eyebrow="Watch, listen & observe" />
          <div class="three-column-grid">
            <div class="topic-column">
              <h3 class="topic-label">Video Explainers</h3>
              <p class="card-description">Vertical video explainers breaking down policy and institutional developments.</p>
              <a class="text-link" href="/formats/video/">Explore video desk →</a>
            </div>
            <div class="topic-column">
              <h3 class="topic-label">Podcasts</h3>
              <p class="card-description">Spoken conversations and audio journalism on collegiate culture and public issues.</p>
              <a class="text-link" href="/formats/podcast/">Explore audio desk →</a>
            </div>
            <div class="topic-column">
              <h3 class="topic-label">Photo Features</h3>
              <p class="card-description">Visual essays and observational photography documenting communities and transit.</p>
              <a class="text-link" href="/formats/photo-feature/">Explore visual desk →</a>
            </div>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>
