---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdPlacement from '../components/AdPlacement.astro';
import { getPublishableStories, getSectionMeta } from '../utils/stories';

const allStories = await getPublishableStories();
const podcastStories = allStories.filter((s) => s.data.format === 'podcast');
---

<BaseLayout
  title="Podcasts & Audio Dispatches"
  description="Spoken conversations, audio reporting, and thoughtful student dialogue on pressing public concerns."
>
  <div class="shell archive-page">
    <header class="archive-header reading-width">
      <nav class="breadcrumb-nav" aria-label="Podcast breadcrumbs">
        <a class="text-link breadcrumb" href="/">← Home</a>
        <span class="breadcrumb-separator" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Podcasts</span>
      </nav>
      <p class="eyebrow archive-kicker">Audio Desk <span aria-hidden="true">/</span> GLASNOST</p>
      <h1 class="archive-title">Podcasts &amp; Audio Dispatches</h1>
      <p class="archive-deck">Spoken conversations, audio reporting, and thoughtful student dialogue on pressing public concerns.</p>
    </header>

    <main class="archive-content">
      <section aria-labelledby="podcast-stories-title">
        <h2 id="podcast-stories-title" class="sr-only">Published Podcast Episodes</h2>
        <div class="three-column-grid">
          {podcastStories.map((story) => {
            const section = getSectionMeta(story.data.section);
            return (
              <ArticleCard
                title={story.data.title}
                category={section?.shortLabel ?? 'Broadcast'}
                format="Podcast"
                description={story.data.excerpt ?? story.data.subtitle}
                href={`/stories/${story.data.slug}/`}
                author={story.data.authors?.[0]?.name}
                publishedAt={story.data.publishedAt}
                dateLabel={story.data.dateLabel}
                imageSrc={story.data.heroImage?.src}
                imageAlt={story.data.heroImage?.alt || story.data.title}
              />
            );
          })}
        </div>
      </section>

      <AdPlacement
        label="Media Partner"
        advertiserName="Rhythm Media Solutions"
        imageSrc="/media/ads/ad-rhythm-media.jpg"
        imageAlt="Rhythm Media Solutions"
        tagline="Digital Audio Strategy, Podcasting Infrastructure & Broadcast Distribution"
      />
    </main>
  </div>
</BaseLayout>
