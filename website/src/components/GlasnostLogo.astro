---
interface Props {
  variant?: 'full' | 'mark';
  size?: number;
  width?: number;
  height?: number;
  class?: string;
  src?: string;
  alt?: string;
}

const {
  variant = 'full',
  size = 40,
  width,
  height,
  class: className = '',
  src,
  alt,
} = Astro.props;

const defaultFullSrc = '/media/branding/glasnost-logo.png';
const defaultMarkSrc = '/media/branding/glasnost-mark.png';
const defaultFullAlt = 'Glasnost — See Through The News';
const defaultMarkAlt = 'Glasnost official emblem';
---

{variant === 'mark' ? (
  <img
    src={src || defaultMarkSrc}
    alt={alt || defaultMarkAlt}
    width={width ?? size}
    height={height ?? size}
    class:list={['glasnost-mark-img', className]}
    loading="eager"
    decoding="async"
  />
) : (
  <img
    src={src || defaultFullSrc}
    alt={alt || defaultFullAlt}
    width={width ?? 520}
    height={height ?? 148}
    class:list={['glasnost-full-logo-img', className]}
    loading="eager"
    decoding="async"
  />
)}

