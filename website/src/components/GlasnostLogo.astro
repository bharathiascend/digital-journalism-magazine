---
interface Props {
  variant?: 'full' | 'mark';
  size?: number;
  width?: number;
  height?: number;
  class?: string;
}

const {
  variant = 'full',
  size = 40,
  width,
  height,
  class: className = '',
} = Astro.props;
---

{variant === 'mark' ? (
  <img
    src="/media/branding/glasnost-mark.png"
    alt="Glasnost official emblem"
    width={width ?? size}
    height={height ?? size}
    class:list={['glasnost-mark-img', className]}
    loading="eager"
    decoding="async"
  />
) : (
  <img
    src="/media/branding/glasnost-logo.png"
    alt="Glasnost — See Through The News"
    width={width ?? 520}
    height={height ?? 148}
    class:list={['glasnost-full-logo-img', className]}
    loading="eager"
    decoding="async"
  />
)}
