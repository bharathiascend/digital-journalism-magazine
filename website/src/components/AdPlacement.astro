---
interface Props {
  label?: string;
  imageSrc?: string;
  imageAlt?: string;
  advertiserName?: string;
  tagline?: string;
}
const {
  label = 'Advertisement',
  imageSrc,
  imageAlt,
  advertiserName,
  tagline,
} = Astro.props;
---
<aside class="ad-placement" aria-label={label}>
  <div class="ad-header-row">
    <span class="eyebrow">{label} <span aria-hidden="true">/</span> Commercial Feature</span>
    {advertiserName && <span class="ad-advertiser-name">{advertiserName}</span>}
  </div>
  {imageSrc && (
    <div class="ad-artwork-frame">
      <img
        src={imageSrc}
        alt={imageAlt || `${advertiserName || label} promotional creative`}
        class="ad-artwork-img"
        loading="eager"
        decoding="async"
      />
      {tagline && <p class="ad-tagline-text">{tagline}</p>}
      <p class="ad-disclosure-note">
        Official Commercial Partner <span aria-hidden="true">·</span> Sponsored Placement
      </p>
    </div>
  )}
</aside>
