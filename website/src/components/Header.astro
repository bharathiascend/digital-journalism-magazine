---
import Navigation from './Navigation.astro';
import GlasnostLogo from './GlasnostLogo.astro';
---
<header class="site-header">
  <div class="shell">
    <div class="masthead-meta">
      <span>Independent Perspectives <span aria-hidden="true">·</span> Student Voices</span>
      <span>Chennai &amp; National Dispatches <span aria-hidden="true">·</span> Est. 2026</span>
    </div>
    <div class="masthead-block">
      <a class="masthead" href="/" aria-label="Glasnost — See Through The News">
        <GlasnostLogo variant="full" class="masthead-logo-artwork" />
      </a>
      <p class="masthead-description">An Independent Journal of Student Reporting, Civic Inquiry &amp; Cultural Commentary</p>
    </div>
    <Navigation />
  </div>
</header>
