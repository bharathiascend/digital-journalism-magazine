---
import Navigation from './Navigation.astro';
import GlasnostLogo from './GlasnostLogo.astro';
import appearance from '../data/appearance.json';
---
<header class="site-header">
  <div class="shell">
    <div class="masthead-meta">
      <span>{appearance.metaBannerLeft}</span>
      <span>{appearance.metaBannerRight}</span>
    </div>
    <div class="masthead-block">
      <a class="masthead" href="/" aria-label={`${appearance.siteTitle} — See Through The News`}>
        <GlasnostLogo
          variant="full"
          src={appearance.logoImage}
          alt={appearance.logoAlt}
          class="masthead-logo-artwork"
        />
      </a>
      <p class="masthead-description">{appearance.tagline}</p>
    </div>
    <Navigation />
  </div>
</header>

