---
interface Props { id: string; title: string; eyebrow?: string; href?: string; linkLabel?: string; }
const { id, title, eyebrow, href, linkLabel = 'View sample article' } = Astro.props;
---
<div class="section-heading">
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2 id={id}>{title}</h2></div>
  {href && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>}
</div>
