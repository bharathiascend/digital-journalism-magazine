---
const sectionLinks = [
  { label: 'Home', href: '/' },
  { label: 'National', href: '/sections/national/' },
  { label: 'Politics', href: '/sections/politics/' },
  { label: 'News Analysis', shortLabel: 'Analysis', href: '/sections/analysis/' },
  { label: 'Lifestyle & Entertainment', shortLabel: 'Lifestyle', href: '/sections/lifestyle/' },
  { label: 'Sports', href: '/sections/sports/' },
  { label: 'Blog', shortLabel: 'Blog', href: '/formats/blog/' },
];

const formatLinks = [
  { label: 'Student Blog', shortLabel: 'Blog', href: '/formats/blog/' },
  { label: 'Articles & Essays', shortLabel: 'Articles', href: '/formats/article/' },
  { label: 'Photo Features', shortLabel: 'Photos', href: '/formats/photo-feature/' },
  { label: 'Podcasts', shortLabel: 'Podcasts', href: '/formats/podcast/' },
  { label: 'Video Explainers', shortLabel: 'Video', href: '/formats/video/' },
  { label: 'Opinion Polls', shortLabel: 'Poll Reports', href: '/formats/poll-report/' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<nav class="navigation" aria-label="Main navigation" data-navigation>
  <div class="nav-mobile-bar">
    <span class="eyebrow">Glasnost Navigation</span>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation-panel" hidden>
      <span data-menu-label>Menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <div id="primary-navigation-panel" class="nav-panel">
    <!-- Primary Topic Tier -->
    <div class="nav-tier nav-tier-primary">
      <span class="nav-group-label mobile-only">Topics</span>
      <ul class="nav-links">
        {sectionLinks.map(({ label, shortLabel, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              <span class="label-full">{label}</span>
              {shortLabel && <span class="label-short">{shortLabel}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Secondary Format / Explore Tier -->
    <div class="nav-tier nav-tier-formats">
      <div class="nav-formats-inner">
        <span class="nav-explore-label">Explore</span>
        <ul class="format-links">
          {formatLinks.map(({ label, shortLabel, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="label-full">{label}</span>
                <span class="label-short">{shortLabel}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  const navigation = document.querySelector<HTMLElement>('[data-navigation]');
  if (navigation) {
    const button = navigation.querySelector<HTMLButtonElement>('.menu-toggle')!;
    const panel = navigation.querySelector<HTMLElement>('.nav-panel')!;
    const label = button.querySelector<HTMLElement>('[data-menu-label]')!;
    const mobile = window.matchMedia('(max-width: 47.99rem)');

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      panel.hidden = mobile.matches && !open;
    };

    const sync = () => {
      const focusWasInPanel = panel.contains(document.activeElement);
      const focusWasOnButton = document.activeElement === button;
      button.hidden = !mobile.matches;
      setOpen(false);
      if (mobile.matches && focusWasInPanel) button.focus();
      if (!mobile.matches && focusWasOnButton) panel.querySelector('a')?.focus();
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

    navigation.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a') && mobile.matches) {
        button.focus();
        setOpen(false);
      }
    });

    mobile.addEventListener('change', sync);
    sync();
  }
</script>
